/*
 * Pluto split keyboard - shared devicetree configuration
 *
 * Pin mapping derived from config.yaml (Ergogen PCB):
 *
 * COLUMNS (col-gpios, per half - same nets on both sides):
 *   col0 = first  = P0.20 = &pro_micro 3
 *   col1 = second = P0.22 = &pro_micro 4
 *   col2 = third  = P0.24 = &pro_micro 5
 *   col3 = fourth = P1.00 = &pro_micro 6
 *   col4 = fifth  = P0.11 = &pro_micro 7
 *   col5 = sixth  = P0.17 = &pro_micro 2
 *
 * ROWS (row-gpios, same nets on both sides):
 *   row0 = num    = P0.31 = &pro_micro 10
 *   row1 = top    = P0.29 = &pro_micro 11
 *   row2 = home   = P0.02 = &pro_micro 12
 *   row3 = bottom = P1.15 = &pro_micro 13
 *   row4 = mod    = P1.13 = &pro_micro 14
 *
 * Diode direction: col2row
 * (signal path: COL -> switch -> diode anode -> diode cathode -> ROW)
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    /*
     * The kscan rows are shared across both halves.
     * The col-gpios are defined per-half in the left/right overlays.
     */
    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        row-gpios
            = <&pro_micro 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* row0: num    P0.31 */
            , <&pro_micro 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* row1: top    P0.29 */
            , <&pro_micro 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* row2: home   P0.02 */
            , <&pro_micro 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* row3: bottom P1.15 */
            , <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* row4: mod    P1.13 */
            ;
    };

    /*
     * Matrix transform: 5 rows x 12 columns (6 per half).
     * Left half  occupies columns 0-5  (col-offset = 0, default).
     * Right half occupies columns 6-11 (col-offset = 6, set in right overlay).
     *
     * Physical key order in the map matches the keymap bindings order:
     * left half top-to-bottom left-to-right, then right half top-to-bottom left-to-right.
     *
     * Row order (num=0 is the top row of keys):
     *   RC(0,x) = num row
     *   RC(1,x) = top row
     *   RC(2,x) = home row
     *   RC(3,x) = bottom row
     *   RC(4,x) = mod row
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;
        map = <
        /* LEFT (cols 0-5)                          RIGHT (cols 6-11)                        */
        /* first  second third  fourth fifth  sixth | sixth  fifth  fourth third  second first */
           RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)   RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
           RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)   RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
           RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)   RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
           RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)   RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
           RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)   RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11)
        >;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        kscan = <&kscan0>;
        transform = <&default_transform>;
    };

    chosen {
        zmk,physical-layout = &physical_layout0;
        zmk,kscan = &kscan0;
    };
};
