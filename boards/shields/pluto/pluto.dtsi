/*
 * Pluto split keyboard - shared devicetree configuration
 *
 * Using direct &gpio0/&gpio1 references (not &pro_micro) to avoid
 * connector gpio-map restrictions. Pin mapping from config.yaml:
 *
 * ROWS (shared across both halves, same physical nets):
 *   row0 = num    P0.31 -> &gpio0 31
 *   row1 = top    P0.29 -> &gpio0 29
 *   row2 = home   P0.02 -> &gpio0 2
 *   row3 = bottom P1.15 -> &gpio1 15
 *   row4 = mod    P1.13 -> &gpio1 13
 *
 * COLUMNS (defined per-half in left/right overlays):
 *   col first:  P0.20 -> &gpio0 20
 *   col second: P0.22 -> &gpio0 22
 *   col third:  P0.24 -> &gpio0 24
 *   col fourth: P1.00 -> &gpio1 0
 *   col fifth:  P0.11 -> &gpio0 11
 *   col sixth:  P0.17 -> &gpio0 17
 *
 * Diode direction: col2row
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        row-gpios
            = <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* row0: num    P0.31 */
            , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* row1: top    P0.29 */
            , <&gpio0  2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* row2: home   P0.02 */
            , <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* row3: bottom P1.15 */
            , <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* row4: mod    P1.13 */
            ;
    };

    /*
     * 5 rows x 12 columns (6 per half).
     * Left  = cols 0-5  (no offset)
     * Right = cols 6-11 (col-offset = 6, set in right overlay)
     *
     * Row 0 = num (top), row 4 = mod (bottom).
     * Column order left→right on left half: first→sixth
     * Column order left→right on right half (mirrored PCB): sixth→first
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;
        map = <
        /* LEFT half cols 0-5            RIGHT half cols 6-11 */
           RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)   RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
           RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)   RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
           RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)   RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
           RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)   RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
           RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)   RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11)
        >;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        kscan = <&kscan0>;
        transform = <&default_transform>;
    };

    chosen {
        zmk,physical-layout = &physical_layout0;
        zmk,kscan = &kscan0;
    };
};
