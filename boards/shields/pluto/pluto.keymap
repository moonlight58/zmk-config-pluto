/*
 * Pluto Keyboard - Default Keymap
 *
 * 60 keys total: 6 cols x 5 rows x 2 halves
 * Key positions match the matrix transform order:
 *   Left half first (col0-5), then right half (col6-11), row by row top to bottom.
 *
 * Layer 0: Default (QWERTY)
 * Layer 1: Lower  (numbers, symbols)
 * Layer 2: Raise  (F-keys, navigation)
 *
 * Adjust these bindings to your liking!
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        /*
         * Layer 0: Default (QWERTY)
         *
         * ,------------------------------------------.   ,------------------------------------------.
         * |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  | BKSP |
         * |------+------+------+------+------+------|   |------+------+------+------+------+------|
         * | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  ;  |  '   |
         * |------+------+------+------+------+------|   |------+------+------+------+------+------|
         * | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  | SHFT |
         * |------+------+------+------+------+------|   |------+------+------+------+------+------|
         * |  ESC | GUI | ALT |LOWER|  SPC |  SPC|   | ENT | ENT |RAISE| ALT | GUI  | CTRL |
         * `------------------------------------------'   `------------------------------------------'
         * (num row)
         * |  `  |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  |  -   |
         */

        default_layer {
            bindings = <
            /* row0: num row — left                              right */
            &kp GRAVE  &kp N1    &kp N2    &kp N3    &kp N4    &kp N5      &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS
            /* row1: top row */
            &kp TAB    &kp Q     &kp W     &kp E     &kp R     &kp T       &kp Y     &kp U     &kp I     &kp O     &kp P     &kp BSPC
            /* row2: home row */
            &kp LCTRL  &kp A     &kp S     &kp D     &kp F     &kp G       &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT
            /* row3: bottom row */
            &kp LSHFT  &kp Z     &kp X     &kp C     &kp V     &kp B       &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT
            /* row4: mod row */
            &kp ESC    &kp LGUI  &kp LALT  &mo 1     &kp SPACE &kp SPACE   &kp RET   &kp RET   &mo 2     &kp RALT  &kp RGUI  &kp RCTRL
            >;
        };

        /*
         * Layer 1: Lower (symbols & F-keys left side)
         *
         * ,------------------------------------------.   ,------------------------------------------.
         * |      |  F1 |  F2 |  F3 |  F4 |  F5 |   |  F6 |  F7 |  F8 |  F9 | F10 | F11  |
         * |------+------+------+------+------+------|   |------+------+------+------+------+------|
         * |      |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  |  F12 |
         * |------+------+------+------+------+------|   |------+------+------+------+------+------|
         * |      |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |      |
         * |------+------+------+------+------+------|   |------+------+------+------+------+------|
         * |      |     |     |     |     |     |   |     |     |     |     |      |      |
         */

        lower_layer {
            bindings = <
            /* row0 */
            &trans     &kp F1    &kp F2    &kp F3    &kp F4    &kp F5      &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11
            /* row1 */
            &trans     &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT   &kp CARET &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR  &kp F12
            /* row2 */
            &trans     &trans    &trans    &trans    &trans    &trans       &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT  &kp BSLH  &kp GRAVE
            /* row3 */
            &trans     &trans    &trans    &trans    &trans    &trans       &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC  &kp PIPE  &kp TILDE
            /* row4 */
            &trans     &trans    &trans    &trans    &trans    &trans       &trans    &trans    &trans    &trans    &trans    &trans
            >;
        };

        /*
         * Layer 2: Raise (navigation, Bluetooth, media)
         *
         * ,------------------------------------------.   ,------------------------------------------.
         * |      |BT 0 |BT 1 |BT 2 |BT 3 |BT 4 |   |     |     |     |     |     |BT CLR|
         * |------+------+------+------+------+------|   |------+------+------+------+------+------|
         * |      |     |     |     |     |     |   | HOME| PGDN| PGUP| END |     |  DEL |
         * |------+------+------+------+------+------|   |------+------+------+------+------+------|
         * |      |     |     |     |     |     |   | LEFT| DOWN|  UP |RIGHT|     |      |
         * |------+------+------+------+------+------|   |------+------+------+------+------+------|
         * |      |     |     |     |     |     |   |     | MUTE| V-  | V+  |     |      |
         */

        raise_layer {
            bindings = <
            /* row0 */
            &trans     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &trans    &trans       &trans       &trans    &trans    &bt BT_CLR
            /* row1 */
            &trans     &trans    &trans    &trans    &trans    &trans          &kp HOME  &kp PG_DN &kp PG_UP &kp END   &trans    &kp DEL
            /* row2 */
            &trans     &trans    &trans    &trans    &trans    &trans          &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &trans    &trans
            /* row3 */
            &trans     &trans    &trans    &trans    &trans    &trans          &trans    &kp K_MUTE &kp C_VOL_DN &kp C_VOL_UP &trans &trans
            /* row4 */
            &trans     &trans    &trans    &trans    &trans    &trans          &trans    &trans    &trans    &trans    &trans    &trans
            >;
        };
    };
};
