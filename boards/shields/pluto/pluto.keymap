/*
 * Pluto Keyboard - Default Keymap
 *
 * 60 keys total: 6 cols x 5 rows x 2 halves
 * Key positions match the matrix transform order:
 *   Left half first (col0-5), then right half (col6-11), row by row top to bottom.
 *
 * Layer 0: Default (QWERTY)
 * Layer 1: Lower  (numbers, symbols)
 * Layer 2: Raise  (F-keys, navigation, media)
 *
 * AZERTY note: ZMK sends raw HID scancodes. The OS (French AZERTY layout) translates them.
 * All keycodes below are written as their QWERTY HID position — the OS does the rest.
 *
 * Bracket/brace AZERTY reference (French legacy AZERTY, kbdlayout.info/KBDFR):
 *   (  →  base N5          (the '5' key, unshifted on AZERTY gives '(')
 *   )  →  base LBKT        (the key right of '0', unshifted on AZERTY gives ')')
 *   {  →  AltGr + N4       (AltGr+4 on AZERTY gives '{')
 *   }  →  AltGr + EQUAL    (AltGr+= on AZERTY gives '}')
 *   [  →  AltGr + N5       (AltGr+5 on AZERTY gives '[')
 *   ]  →  AltGr + LBKT     (AltGr+key-right-of-0 on AZERTY gives ']')
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        /*
         * Layer 0: Default (QWERTY) -> (AZERTY for French layout)
         *
         * ,------------------------------------.        ,------------------------------------.
         * |  ESC |  1  |  2  |  3  |  4  |  5  |        |  6  |  7  |  8  |  9  |  0  |  +=  |
         * |------+-----+-----+-----+-----+-----|        |-----+-----+-----+-----+-----+------|
         * |  TAB |  Q  |  W  |  E  |  R  |  T  |        |  Y  |  U  |  I  |  O  |  P  | BKSP |
         * |------+-----+-----+-----+-----+-----|        |-----+-----+-----+-----+-----+------|
         * | CAPS |  A  |  S  |  D  |  F  |  G  |        |  H  |  J  |  K  |  L  |  ;  |  ENT |
         * |------+-----+-----+-----+-----+-----|        |-----+-----+-----+-----+-----+------|
         * | SHFT |  Z  |  X  |  C  |  V  |  B  |        |  N  |  M  |  ,  |  .  |  /  | SHFT |
         * |------+-----+-----+-----+-----+-----|        |-----+-----+-----+-----+-----+------|
         * | CTRL |     | GUI | ALT |LOWER| SPC |        | SPC |RAISE| ALT | GUI |     | CTRL |
         * `------------------------------------'        `------------------------------------'
         */

        default_layer {
            bindings = <
            /* row0: num row — left                                            right */
            &kp ESC    &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    /**/  &kp N6      &kp N7    &kp N8    &kp N9    &kp N0    &kp KP_PLUS
            /* row1: top row */
            &kp TAB    &kp Q     &kp W     &kp E     &kp R     &kp T     /**/  &kp Y       &kp U     &kp I     &kp O     &kp P     &kp BSPC
            /* row2: home row */
            &kp CAPS   &kp A     &kp S     &kp D     &kp F     &kp G     /**/  &kp H       &kp J     &kp K     &kp L     &kp SEMI  &kp RET
            /* row3: bottom row */
            &kp LSHFT  &kp Z     &kp X     &kp C     &kp V     &kp B     /**/  &kp N       &kp M     &kp COMMA &kp DOT   &kp FSLH  &kp RSHFT
            /* row4: mod row */
            &kp LCTRL  &trans    &kp LGUI  &kp LALT  &mo 1     &kp SPACE /**/  &kp SPACE   &mo 2     &kp RALT  &kp RGUI  &trans    &kp RCTRL
            >;
        };

        /*
         * Layer 1: Lower (symbols — AZERTY-correct)
         *
         * All bracket/brace/paren positions are translated for the French AZERTY OS layout.
         * AltGr combos use RA() (Right Alt / AltGr).
         *
         * ,-----------------------------------.        ,-----------------------------------.
         * |  F1 |  F2 |  F3 |  F4 |  F5 |  F6 |        |  F7 |  F8 |  F9 | F10 | F11 | F12 |
         * |-----+-----+-----+-----+-----+-----|        |-----+-----+-----+-----+-----+-----|
         * |     |     |     |  (  |  )  |     |        |     |  <  |  >  |     |     |  *  |
         * |-----+-----+-----+-----+-----+-----|        |-----+-----+-----+-----+-----+-----|
         * |     |     |     |  {  |  }  |     |        |     |  [  |  ]  |     |     |     |
         * |-----+-----+-----+-----+-----+-----|        |-----+-----+-----+-----+-----+-----|
         * |     |     |     |     |     |     |        |     |     |     |     |     |     |
         * |-----+-----+-----+-----+-----+-----|        |-----+-----+-----+-----+-----+-----|
         * |     |     |     |     |     |     |        |     |     |     |     |     |     |
         * `-----------------------------------'        `-----------------------------------'
         *
         * AZERTY symbol mapping used here:
         *   (  = N5          (unshifted 5 on AZERTY)
         *   )  = LBKT        (unshifted key-right-of-0 on AZERTY)
         *   {  = RA(N4)      (AltGr+4 on AZERTY)
         *   }  = RA(EQUAL)   (AltGr+= on AZERTY)
         *   [  = RA(N5)      (AltGr+5 on AZERTY)
         *   ]  = RA(LBKT)    (AltGr+key-right-of-0 on AZERTY)
         *   <  = OEM_102     (the ISO extra key, unshifted)
         *   >  = LS(OEM_102) (same key, shifted)
         */

        lower_layer {
            bindings = </* left                                                              right */
            /* row0 */
            &kp F1     &kp F2    &kp F3    &kp F4          &kp F5            &kp F6  /**/  &kp F7    &kp F8              &kp F9              &kp F10   &kp F11   &kp F12
            /* row1 */
            &trans     &trans    &trans    &kp N5          &kp MINUS          &trans  /**/  &trans    &kp NON_US_BSLH     &kp LS(NON_US_BSLH) &trans    &trans    &kp BSLH
            /* row2 */
            &trans     &trans    &trans    &kp RA(N4)      &kp RA(EQUAL)     &trans  /**/  &trans    &kp RA(N5)          &kp RA(MINUS)        &trans    &trans    &trans
            /* row3 */
            &trans     &trans    &trans    &trans          &trans            &trans  /**/  &trans    &trans              &trans              &trans    &trans    &trans
            /* row4 */
            &trans     &trans    &trans    &trans          &trans            &trans  /**/  &trans    &trans              &trans              &trans    &trans    &trans
            >;
        };

        /*
         * Layer 2: Raise (navigation, Bluetooth, media, brightness)
         *
         * Media and brightness are on the LEFT half so they are reachable
         * while the right thumb holds the Raise key.
         *
         * ,-------------------------------------.        ,------------------------------------.
         * |     |BT 0 |BT 1 |BT 2 |BT 3 |BT 4  |        |     |     |     |     |     |BT CLR|
         * |-----+-----+-----+-----+-----+-------|        |-----+-----+-----+-----+-----+------|
         * |     |     |     |     |     |       |        |     |     |  UP |     |     | DEL  |
         * |-----+-----+-----+-----+-----+-------|        |-----+-----+-----+-----+-----+------|
         * |     |     |     |     |     |       |        |     | LEFT| DOWN|RIGHT|     |      |
         * |-----+-----+-----+-----+-----+-------|        |-----+-----+-----+-----+-----+------|
         * |     |PREV | PP  |NEXT |     |       |        |     |     |     |     |     |      |
         * |-----+-----+-----+-----+-----+-------|        |-----+-----+-----+-----+-----+------|
         * |     |MUTE |VOL- |VOL+ |BRI- |BRI+   |        |     |     |     |     |     |      |
         * `-------------------------------------'        `------------------------------------'
         */

        raise_layer {
            bindings = <
            /* row0 */
            &trans     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4     &trans    &trans     &trans     &trans    &trans    &bt BT_CLR
            /* row1 */
            &trans     &trans       &trans       &trans       &trans       &trans           &trans    &trans     &kp UP     &trans    &trans    &kp DEL
            /* row2 */
            &trans     &trans       &trans       &trans       &trans       &trans           &trans    &kp LEFT   &kp DOWN   &kp RIGHT &trans    &trans
            /* row3 */
            &trans     &kp C_PREV   &kp C_PP     &kp C_NEXT   &trans       &trans           &trans    &trans     &trans     &trans    &trans    &trans
            /* row4 */
            &trans     &kp C_MUTE   &kp C_VOL_DN &kp C_VOL_UP &kp C_BRI_DN &kp C_BRI_UP     &trans    &trans     &trans     &trans    &trans    &trans
            >;
        };
    };
};
